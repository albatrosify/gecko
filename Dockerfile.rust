# ==========================================
# GECKO v2 — Multi-Stage High-Performance Container
# ==========================================

# ------------------------------------------
# Stage 1: Build React/Vite Frontend Assets
# ------------------------------------------
FROM node:20-bookworm-slim AS frontend-builder

WORKDIR /build

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

COPY index.html vite.config.ts tsconfig.json ./
COPY src/ ./src/

ARG VITE_APP_VERSION=unknown
ARG VITE_APP_COMMIT_HASH=unknown
ENV VITE_APP_VERSION=$VITE_APP_VERSION \
    VITE_APP_COMMIT_HASH=$VITE_APP_COMMIT_HASH \
    NODE_ENV=production
RUN npm run build

# ------------------------------------------
# Stage 2: Chef Base
# ------------------------------------------
FROM lukemathwalker/cargo-chef:latest-rust-slim AS chef

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------
# Stage 3: Planner (Calculates Dependency Recipe)
# ------------------------------------------
FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

RUN cargo chef prepare --recipe-path recipe.json

# ------------------------------------------
# Stage 4: Builder (Cooks & Caches Dependencies)
# ------------------------------------------
FROM chef AS builder

# Build external dependencies first — this layer is completely cached when dependencies don't change
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release --recipe-path recipe.json

# Copy workspace source code and built frontend
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY --from=frontend-builder /build/dist ./dist

# Compile only workspace crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release -p gecko-server

# ------------------------------------------
# Stage 5: Minimal Production Runtime
# ------------------------------------------
FROM debian:trixie-slim AS runtime

# Install runtime utilities: ffmpeg (for DVR remux & stream repair), ca-certificates, curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for security
RUN groupadd -g 1000 gecko && useradd -u 1000 -g gecko -m -s /bin/bash gecko

WORKDIR /app
RUN mkdir -p /app/data && chown -R gecko:gecko /app

# Copy binary from builder
COPY --from=builder /build/target/release/gecko /usr/local/bin/gecko

USER gecko

ENV PORT=3000 \
    SQLITE_PATH=/app/data/gecko.db \
    APP_URL=http://localhost:3000 \
    RUST_LOG=info,gecko=debug

EXPOSE 3000

VOLUME ["/app/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

ENTRYPOINT ["/usr/local/bin/gecko"]
