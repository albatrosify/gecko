# Database
SQLITE_PATH=/app/data/gecko.db

# Cache backend
# sqlite (default) — persists the cache to the SQLite DB; survives restarts.
# memory          — keeps the entire cache in RAM; faster, but lost on restart.
CACHE_BACKEND=sqlite

# App
# Use a long random string — e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# The address your IPTV clients use to reach this server (LAN IP or domain)
APP_URL=http://YOUR_LAN_IP:3000
PORT=3000
