# Database
SQLITE_PATH=/app/data/gecko.db

# App
# Use a long random string — e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# The address your IPTV clients use to reach this server (LAN IP or domain)
APP_URL=http://YOUR_LAN_IP:3000
PORT=3000

# Live audio transcoding for the web player (AC-3/E-AC-3/DTS/MP2 -> AAC).
# The video bitstream is always copied, never re-encoded. 0 disables the feature.
GECKO_MAX_AUDIO_TRANSCODES=4
# Optional: path to the ffmpeg binary (default: ffmpeg from PATH)
# GECKO_FFMPEG_PATH=ffmpeg
